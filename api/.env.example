# Supabase project of the EPHIA Patient Management System (API URL, public).
SUPABASE_URL=https://grfngjgjiipbgntsduom.supabase.co
# Where verified auth links land when Supabase passes no redirect_to.
APP_URL=https://invoicing.ephia.de/
# Secret from Supabase > Authentication > Hooks > Send Email ("v1,whsec_…").
AUTH_EMAIL_HOOK_SECRET=
# Resend API key with sending rights for ephia.de.
RESEND_API_KEY=
# Sender of every auth mail. Replies to noreply@ get the auto-responder.
EMAIL_FROM=EPHIA <noreply@ephia.de>

# ── Secure document sending ──
# Supabase > Project Settings > API: service_role (or sb_secret_) key. Server only.
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64: openssl rand -base64 32. Encrypts the stored key halves.
# Changing it makes every open link unusable (they can be resent).
SHARE_KEY_SECRET=
# Resend > Webhooks (email.delivered, bounced, complained, failed) → /api/resend/webhook
RESEND_WEBHOOK_SECRET=
# Optional, default noreply@ephia.de. Display name is "{Praxis} über EPHIA".
SHARE_EMAIL_FROM_ADDRESS=noreply@ephia.de

# ── Invitations from admin.ephia.de (POST /api/invites) ──
# Same value as PMS_INVITE_SECRET in ephia-admin. At least 32 characters: openssl rand -base64 32
PMS_INVITE_SECRET=
# Public URL of this service; the invite email links to {API_URL}/i/<token>.
API_URL=https://api.pms.ephia.de
